---
import Base from "../layouts/Base.astro";
import DocList from "../components/DocList.astro";
import { experience } from "../data/experience";
---
<Base title="Experience">
  <div class="wrap page">
    <p class="kicker">Experience</p>
    <h1>Labs, internships, and teams</h1>
    {experience.map((item) => (
      <article class="card entry">
        <p class="meta">{item.dates} · {item.location}</p>
        <h2>{item.title}</h2>
        <p>{item.org}</p>
        <ul>
          {item.bullets.map((bullet) => <li>{bullet}</li>)}
        </ul>
        {item.github && (
          <p>
            <a href={item.github} target="_blank" rel="noopener">GitHub repository</a>
          </p>
        )}
        {item.supervisor && (
          <p class="meta">
            Reference: {item.supervisor}
            {item.supervisorEmail && (
              <>
                {" · "}
                <a href={`mailto:${item.supervisorEmail}`}>{item.supervisorEmail}</a>
              </>
            )}
          </p>
        )}
        {item.letters?.length ? (
          <DocList title="Recommendation letters" items={item.letters} />
        ) : null}
        {item.certificate && (
          <DocList
            title="Certificate"
            items={[{
              label: `${item.org} certificate`,
              kind: "PDF",
              href: item.certificate,
              preview: item.certificatePreview,
            }]}
          />
        )}
        {item.photos?.length ? (
          <div class="gallery">
            {item.photos.map((photo) => (
              <figure>
                <img src={photo} alt="" />
              </figure>
            ))}
          </div>
        ) : null}
      </article>
    ))}
  </div>
</Base>
