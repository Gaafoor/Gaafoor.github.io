---
import Base from "../layouts/Base.astro";
import { publications } from "../data/publications";
import { paperCopyright } from "../data/copyright";
---
<Base title="Publications">
  <div class="wrap page">
    <p class="kicker">Publications</p>
    <h1>Theses and papers</h1>
    {publications.map((item) => (
      <article class="card entry">
        <p class="meta">{item.year} · {item.status}</p>
        <h2>{item.title}</h2>
        <p>{item.authors}</p>
        <p>{item.venue}</p>
        {"keywords" in item && item.keywords && <p class="meta">{item.keywords}</p>}
        <p>
          {item.link ? <a href={item.link}>{item.link.startsWith("http") ? "arXiv / external PDF" : "Open PDF"}</a> : null}
          {item.link && item.code ? " · " : null}
          {"code" in item && item.code ? <a href={item.code}>GitHub code</a> : null}
        </p>
        {"copyright" in item && item.copyright && <p class="copyright-note">{paperCopyright}</p>}
      </article>
    ))}
  </div>
</Base>
