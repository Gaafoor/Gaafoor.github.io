---
import Base from "../layouts/Base.astro";
import { site } from "../data/site";
import { education } from "../data/education";
import { skillGroups } from "../data/skills";
import { projects } from "../data/projects";

const featured = projects.filter((p) => p.featured).slice(0, 6);
---
<Base>
  <div class="wrap">
    <section class="hero">
      <div class="avatar">
        <img src="/media/profile/mostafa.jpg" alt={site.name} />
      </div>
      <div>
        <p class="badge">{site.lookingFor}</p>
        <h1>{site.name}</h1>
        <p class="meta">{site.role} · {site.location}</p>
        <p>{site.intro}</p>
        <div class="actions">
          <a class="btn" href="/contact/">Contact</a>
          <a class="btn-ghost" href="/projects/">View projects</a>
          <a class="btn-ghost" href={site.cv}>Download CV</a>
        </div>
        <p class="social">
          <a href={`mailto:${site.email}`}>Email</a>
          <a href={site.github}>GitHub</a>
          <a href={site.linkedin}>LinkedIn</a>
        </p>
      </div>
    </section>

    <section class="section" id="education">
      <div class="section-head">
        <div>
          <p class="kicker">Education</p>
          <h2>Where I study</h2>
        </div>
        <a class="more" href="/education/">See details →</a>
      </div>
      <div class="grid-2">
        {education.map((item) => (
          <article class="card">
            <p class="meta">{item.dates}{item.grade ? ` · ${item.grade}` : ""}</p>
            <h3>{item.degree}</h3>
            <p>{item.institution}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="section" id="skills">
      <div class="section-head">
        <div>
          <p class="kicker">Skills</p>
          <h2>What I work with</h2>
        </div>
        <a class="more" href="/skills/">See details →</a>
      </div>
      {skillGroups.map((group) => (
        <div class="skill-group">
          <h3>{group.name}</h3>
          <div class="chips">
            {group.items.map((item) => <span class="chip">{item}</span>)}
          </div>
        </div>
      ))}
    </section>

    <section class="section" id="projects">
      <div class="section-head">
        <div>
          <p class="kicker">Selected work</p>
          <h2>A few results</h2>
        </div>
        <a class="more" href="/projects/">All projects →</a>
      </div>
      <div class="grid-2">
        {featured.map((project) => (
          <a class="card" href={`/projects/${project.slug}/`} style="color: inherit; text-decoration: none;">
            {project.cover && <img class="cover-img" src={project.cover} alt="" />}
            <p class="meta">{project.period} · {project.tags.join(" · ")}</p>
            <h3>{project.title}</h3>
            <p>{project.summary}</p>
          </a>
        ))}
      </div>
    </section>

    <section class="section" id="contact">
      <p class="kicker">Next</p>
      <h2>I am looking for a robotics PhD / thesis host.</h2>
      <p>If this work is close to your group, write to me at <a href={`mailto:${site.email}`}>{site.email}</a> or call <a href={site.phoneHref}>{site.phone}</a>.</p>
      <a class="more" href="/contact/">Contact page →</a>
    </section>
  </div>
</Base>
